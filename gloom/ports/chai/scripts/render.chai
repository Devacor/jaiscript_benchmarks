// The renderer. The view is a flat truecolor palette-index pixel grid, blitted
// to the terminal through sub-cell block glyphs:
//   half (--pix half): 1x2 px/cell, upper-half-block, fg=top bg=bottom
//   quad (--pix quad): 2x2 px/cell, quadrant glyphs, 2 colors by luminosity
//   sext (--pix sext): 2x3 px/cell, sextant glyphs (needs a Unicode-13 font)
// The reference computes wall columns through parallel_transform; ports run
// the serial-equivalent loop (reference/README.md 4.2) — one cast_wall_ray per cell
// column, identical DDA math, identical bytes.

global PIXW = 2        // pixels per cell horizontally (set by gloom_boot)
global PIXH = 2        // pixels per cell vertically
global RESET = ""
global QUADG = []      // quadrant glyphs by TL|TR<<1|BL<<2|BR<<3
global SEXTG = []      // sextant glyphs by TL|TR<<1|ML<<2|MR<<3|BL<<4|BR<<5
global HALFG = ""      // upper half block
global AM_COLS = []    // automap tile colors (built at boot)
global AM_FLOOR = 0
global AM_BLINK = 0
global AM_ITEM = 0
global AM_ENEMY = 0
global AM_SELF = 0
global AM_HEAD = 0
global HURT_RED = 0
global STRIPS = []      // lazy 33-tall wall texture strips by (kind,side,shade,tx)
global STRIP_SET = []

def init_render() {
	RESET = ESC + "[0m";
	rgb_idx(0, 0, 0);                 // palette index 0 is black (grid clear value)
	HALFG = utf8(0x2580);
	QUADG = [" "];
	var quad_cps = [0x2598, 0x259D, 0x2580, 0x2596, 0x258C, 0x259E, 0x259B,
		0x2597, 0x259A, 0x2590, 0x259C, 0x2584, 0x2599, 0x259F, 0x2588];
	for (cp : quad_cps) { QUADG.push_back(utf8(cp)); }
	SEXTG = [];
	for (var b = 0; b < 64; ++b) {
		if (b == 0) { SEXTG.push_back(" "); }
		else if (b == 21) { SEXTG.push_back(utf8(0x258C)); }        // left half
		else if (b == 42) { SEXTG.push_back(utf8(0x2590)); }        // right half
		else if (b == 63) { SEXTG.push_back(utf8(0x2588)); }        // full
		else {
			var cp = 0x1FB00 + b - 1;
			if (b > 21) { cp -= 1; }
			if (b > 42) { cp -= 1; }
			SEXTG.push_back(utf8(cp));
		}
	}
	AM_COLS = [0, rgb_idx(150, 140, 120), rgb_idx(110, 150, 110), rgb_idx(110, 120, 160), rgb_idx(160, 110, 96),
		rgb_idx(200, 170, 110), rgb_idx(90, 230, 110), rgb_idx(150, 140, 120), rgb_idx(230, 70, 60), rgb_idx(90, 120, 240)];
	AM_FLOOR = rgb_idx(40, 40, 46);
	AM_BLINK = rgb_idx(240, 255, 160);
	AM_ITEM = rgb_idx(255, 220, 80);
	AM_ENEMY = rgb_idx(255, 60, 50);
	AM_SELF = rgb_idx(255, 255, 255);
	AM_HEAD = rgb_idx(255, 250, 140);
	HURT_RED = rgb_idx(200, 30, 24);
	build_particle_colors();
}

// wall tone table: [kind 0..9][side 0..1][shade 0..15][tone 0..2] flattened;
// tones: 0 base, 1 accent, 2 mortar/frame. Truecolor, 16 shades.
global WALLT = []
global CEILP = []     // per pixel-row ceiling color
global FLOORP = []    // per pixel-row floor color

def push_wall_tones(base, accent) {
	for (var side = 0; side < 2; ++side) {
		var facing = side == 1 ? 0.70 : 1.0;
		for (var s = 0; s < 16; ++s) {
			var lum = (0.13 + 87e-2 * s / 15.0) * facing;
			WALLT.push_back(rgb_idx(itrunc(base[0] * lum), itrunc(base[1] * lum), itrunc(base[2] * lum)));
			var alum = lum * 1.35;
			alum = alum > 1.0 ? 1.0 : alum;
			WALLT.push_back(rgb_idx(itrunc(accent[0] * alum), itrunc(accent[1] * alum), itrunc(accent[2] * alum)));
			var mlum = lum * 42e-2;
			WALLT.push_back(rgb_idx(itrunc(base[0] * mlum), itrunc(base[1] * mlum), itrunc(base[2] * mlum)));
		}
	}
}

def build_render_tables(mi) {
	if (SHOWCASE) {
		G.lutc = Map();
		build_showcase_tables(mi);
		return;
	}
	var theme := MAPS[mi]["theme"];
	WALLT = [];
	// kind 0 (never rendered): flat dark
	var zero = [10.0, 10.0, 12.0];
	push_wall_tones(zero, zero);
	// kinds 1..4 from the theme
	for (var k = 0; k < 4; ++k) {
		push_wall_tones(theme["walls"][k], theme["walls"][k]);
	}
	// kind 5 door, 6 exit, 7 red door, 8 blue door (episode constants)
	push_wall_tones([138.0, 116.0, 94.0], [188.0, 164.0, 132.0]);
	push_wall_tones([64.0, 160.0, 84.0], [220.0, 235.0, 120.0]);
	push_wall_tones([176.0, 50.0, 42.0], [245.0, 130.0, 96.0]);
	push_wall_tones([62.0, 94.0, 198.0], [136.0, 176.0, 255.0]);

	// ceiling / floor gradients (dark at the horizon), quantized to CELL rows
	// so flat regions hit the row builder's uniform-cell fast path
	CEILP = [];
	FLOORP = [];
	var crgb := theme["ceil"];
	var frgb := theme["floor"];
	var half = G.vh / 2;
	for (var y = 0; y < G.vh; ++y) {
		var yq = (y / PIXH) * PIXH;
		if (y < half) {
			var t = half > 1 ? 1.0 * yq / (half - 1) : 1.0;
			var lum = 1.0 - 0.72 * t;
			CEILP.push_back(rgb_idx(itrunc(crgb[0] * lum), itrunc(crgb[1] * lum), itrunc(crgb[2] * lum)));
			FLOORP.push_back(0);
		} else {
			var t2 = 1.0 * (yq - half) / imax(1, G.vh - 1 - half);
			t2 = t2 > 1.0 ? 1.0 : (t2 < 0.0 ? 0.0 : t2);
			var lum2 = 0.26 + 0.74 * t2;
			CEILP.push_back(0);
			FLOORP.push_back(rgb_idx(itrunc(frgb[0] * lum2), itrunc(frgb[1] * lum2), itrunc(frgb[2] * lum2)));
		}
	}
	// NO prebaked background grid: ChaiScript vector assignment copies element
	// HANDLES (probed), so a per-frame `pix = bg` aliases the buffers and every
	// pixel write leaks into the "background" — the column loop paints the
	// ceiling/floor gradient per pixel instead (output-identical).
	// wall tone strips (32-tall texture columns) build lazily per combination
	// (slots pre-seeded as empty vectors: ChaiScript `=` can't retype a slot)
	STRIPS = [];
	STRIP_SET = [];
	var nstrips = 10 * 2 * 16 * 32;
	for (var i2 = 0; i2 < nstrips; ++i2) {
		STRIPS.push_back([]);
		STRIP_SET.push_back(0);
	}
}

// texture tone at (tx, ty) in 0..31 for a wall kind: 0 base, 1 accent, 2 mortar
def tex_tone(kind, tx, ty) {
	if (kind == 1) {
		var tone = ((tx >> 2) + (ty >> 2)) & 1;
		if ((ty & 7) == 7) { tone = 2; }
		return tone;
	}
	if (kind == 2) {
		var tone = ((tx + ((ty >> 3 & 1) << 2)) >> 3) & 1;
		if ((ty & 7) == 0) { tone = 2; }
		return tone;
	}
	if (kind == 3) {
		var tone = (tx >> 3) & 1;
		if ((tx & 7) == 0) { tone = 2; }
		return tone;
	}
	if (kind == 4) {
		var tone = ((tx >> 4) + (ty >> 4)) & 1;
		if ((tx & 15) == 0 || (ty & 15) == 0) { tone = 2; }
		return tone;
	}
	if (kind == 6) {
		var tone = ((tx + ty) >> 2) & 1;               // hazard stripes
		if (ty > 26) { tone = 2; }
		return tone;
	}
	// doors (plain / red / blue): frame, seam, lock studs
	if (tx < 3 || tx > 28 || ty < 2 || ty > 29) { return 2; }
	if (tx == 15 || tx == 16) { return 2; }
	if (ty >= 14 && ty <= 17 && (tx & 3) == 1) { return 1; }
	return 0;
}

def build_strip(kind, side, shade, tx) {
	var tbase = ((kind * 2 + side) * 16 + shade) * 3;
	var s = [];
	for (var ty = 0; ty < 32; ++ty) {
		s.push_back(WALLT[tbase + tex_tone(kind, tx, ty)]);
	}
	s.push_back(s[31]);        // fixed-point overshoot guard
	return s;
}

// ---------------------------------------------------------- sprite LUTs -----
// per (art, shade band 0..7, flash) palette-code -> palette-index table,
// cached in G.lutc. LUTs depend only on art/band/flash (never the map theme),
// so the cache lives for the whole session.
global BAND_LUM = [1.0, 0.88, 0.76, 0.64, 0.52, 42e-2, 0.32, 24e-2]

def sprite_lut(name, band, flash, variant) {
	var key = SHOWCASE ? "${name}:${band}:${flash}:${variant}" : "${name}:${band}:${flash}";
	if (G.lutc.count(key) != 0) { return G.lutc[key]; }
	if (SHOWCASE) {
		var slut = showcase_sprite_lut(name, band, flash, variant);
		G.lutc[key] = slut;
		return slut;
	}
	var art := ARTS[name];
	var rgb := art["rgb"];
	var lum = BAND_LUM[band];
	var lut = [0];
	var nc = vlen(rgb);
	for (var c = 1; c < nc; ++c) {
		var r = rgb[c][0];
		var g = rgb[c][1];
		var b = rgb[c][2];
		if (flash == 1) {
			r = imin(255, r + 170);
			g = imin(255, g + 150);
			b = imin(255, b + 140);
		}
		lut.push_back(rgb_idx(itrunc(r * lum), itrunc(g * lum), itrunc(b * lum)));
	}
	G.lutc[key] = lut;
	return lut;
}

// -------------------------------------------------------------- the view ----
def render_view() {
	var vw = G.vw;
	var vh = G.vh;
	var pang = SHOWCASE ? G.pang + G.feel.yaw : G.pang;
	var dirx = cos(pang);
	var diry = sin(pang);
	var planex = 0.0 - diry * 78e-2;
	var planey = dirx * 78e-2;
	var px = G.px;
	var py = G.py;
	var pix := G.pix;
	var zbuf := G.zbuf;
	if (SHOWCASE) {
		showcase_view(pix, zbuf, px, py, dirx, diry, planex, planey);
	} else {
		reference_view(pix, zbuf, px, py, dirx, diry, planex, planey);
	}

	// --- 3. billboards: enemies, pickups, projectiles (far to near) ---
	var det = planex * diry - dirx * planey;
	if (det < 0.0001 && det > -0.0001) { det = 0.0001; }
	var inv = 1.0 / det;
	var sp = [];
	for (e : G.enemies) {
		collect_billboard(sp, e.x, e.y, enemy_art(e), ENEMY_DEFS[e.kind]["size"], 0.0,
			e.flash > 0 ? 1 : 0, inv, dirx, diry, planex, planey, px, py);
	}
	var nitems = vlen(G.items);
	for (var i = 0; i < nitems; ++i) {
		var it := G.items[i];
		if (it[3] == 1) { continue; }
		var ik = it[0];
		collect_billboard(sp, it[1], it[2], ITEM_DEFS[ik]["art"],
			ITEM_DEFS[ik]["size"], 0.0, 0, inv, dirx, diry, planex, planey, px, py);
	}
	var shot_art = ["", "pr_spit", "pr_fire", "pr_hex"];
	var nshots = vlen(G.shots);
	for (var i2 = 0; i2 < nshots; ++i2) {
		var s := G.shots[i2];
		collect_billboard(sp, s[1], s[2], shot_art[s[0]], 0.16, 0.35, 0, inv, dirx, diry, planex, planey, px, py);
	}
	// insertion sort, far first (records: [depth, scx, name, size, zlift, flash, wx, wy])
	var nsp = vlen(sp);
	for (var i3 = 1; i3 < nsp; ++i3) {
		var rec = sp[i3];
		var j = i3 - 1;
		while (j >= 0) {
			if (sp[j][0] >= rec[0]) { break; }
			sp[j + 1] = sp[j];
			j -= 1;
		}
		sp[j + 1] = rec;
	}
	for (rec2 : sp) { draw_billboard(rec2, pix, zbuf); }

	// --- 4. particles: pixel confetti with z-buffer clipping ---
	var pcols := PART_COLS;
	var half2 = SHOWCASE ? HORIZON : vh / 2;
	var pxw = PIXW;
	var pxh = PIXH;
	for (prt : G.fx.pool) {
		var pk = prt[0];
		if (pk == 0) { continue; }
		var rx = prt[1] - px;
		var ry = prt[2] - py;
		var depth = inv * (planex * ry - planey * rx);
		if (depth < 15e-2 || depth > 14.0) { continue; }
		var ttx = inv * (diry * rx - dirx * ry);
		var scx = itrunc((vw / 2.0) * (1.0 + ttx / depth));
		if (scx < 0 || scx >= vw) { continue; }
		if (depth >= zbuf[scx]) { continue; }
		var span = 1.0 * vh / depth;
		var pyx = itrunc(half2 + span * 0.5 - prt[3] * span);
		var life = prt[7];
		var phase = 3 - imin(3, life / 5);
		var color = pcols[pk * 4 + phase];
		var psz = itrunc(0.07 * span) + 1;
		psz = psz > 3 ? 3 : psz;
		var psx = (psz * 2 * pxw) / pxh;           // square-ish regardless of mode
		psx = psx < 1 ? 1 : psx;
		for (var oy = 0; oy < psz; ++oy) {
			var yy = pyx + oy;
			if (yy < 0 || yy >= vh) { continue; }
			for (var ox = 0; ox < psx; ++ox) {
				var xx = scx + ox;
				if (xx >= vw) { continue; }
				if (depth < zbuf[xx]) { pix[yy * vw + xx] = color; }
			}
		}
	}

	// --- 5. the gun in hand and the look's overlays, the automap, hurt flash ---
	if (SHOWCASE) {
		draw_viewmodel(pix);
		G.feel.overlay(pix, vw, vh);
	}
	if (G.automap) { draw_automap(pix); }
	if (!SHOWCASE && G.hurt_flash > 0) {
		var red = HURT_RED;
		var thick = pxw * 2;
		for (var x4 = 0; x4 < vw; ++x4) {
			pix[x4] = red;
			pix[vw + x4] = red;
			pix[(vh - 2) * vw + x4] = red;
			pix[(vh - 1) * vw + x4] = red;
		}
		for (var y4 = 0; y4 < vh; ++y4) {
			var rb = y4 * vw;
			for (var t4 = 0; t4 < thick; ++t4) {
				pix[rb + t4] = red;
				pix[rb + vw - 1 - t4] = red;
			}
		}
	}

	// --- 6. pixel grid -> sub-cell glyph rows ---
	if (PIXH == 3) { return rows_sext(pix); }
	if (PIXW == 2) { return rows_quad(pix); }
	return rows_half(pix);
}

// the reference look's rays and columns
def reference_view(pix, zbuf, px, py, dirx, diry, planex, planey) {
	var vw = G.vw;
	var vh = G.vh;
	// --- 1+2. rays + columns: one ray per CELL column painting ceiling,
	// textured wall slice, floor top-to-bottom (serial-equivalent of the
	// reference's chunked parallel_transform + prebaked background; cy0 is
	// always above the horizon and cy1 below it, so above = CEILP, below =
	// FLOORP, exactly the reference's bg grid)
	var ceilp := CEILP;
	var floorp := FLOORP;
	var pxw = PIXW;
	var ncols = vw / pxw;
	var xstep = 2.0 / (ncols - 1.0);
	var boost = G.muzzle > 0 ? 2 : 0;
	for (var x = 0; x < ncols; ++x) {
		var camx = x * xstep - 1.0;
		cast_wall_ray(px, py, dirx + planex * camx, diry + planey * camx);
		var dist = RAY_D;
		var side = RAY_S;
		var kind = RAY_K;
		var tx = RAY_T >> 1;                  // 0..31
		var px0 = x * pxw;
		zbuf[px0] = dist;
		if (pxw == 2) { zbuf[px0 + 1] = dist; }
		var lineh = itrunc(1.0 * vh / dist);
		lineh = lineh < 1 ? 1 : lineh;
		var y0 = (vh - lineh) / 2;
		var y1 = y0 + lineh;
		var cy0 = y0 < 0 ? 0 : y0;
		var cy1 = y1 > vh ? vh : y1;
		var shade = 15 - itrunc(dist * 1.55) + boost;
		shade = shade < 0 ? 0 : (shade > 15 ? 15 : shade);
		var sidx = ((kind * 2 + side) * 16 + shade) * 32 + tx;
		if (STRIP_SET[sidx] == 0) {
			STRIPS[sidx] = build_strip(kind, side, shade, tx);
			STRIP_SET[sidx] = 1;
		}
		var strip := STRIPS[sidx];
		var tstep = 65536 / lineh;            // (32 << 11) / lineh
		var tacc = (cy0 - y0) * tstep;
		var gi = px0;
		var y = 0;
		if (pxw == 2) {
			while (y < cy0) {
				var c = ceilp[y];
				pix[gi] = c;
				pix[gi + 1] = c;
				gi += vw;
				y += 1;
			}
			while (y < cy1) {
				var c = strip[tacc >> 11];
				pix[gi] = c;
				pix[gi + 1] = c;
				tacc += tstep;
				gi += vw;
				y += 1;
			}
			while (y < vh) {
				var c = floorp[y];
				pix[gi] = c;
				pix[gi + 1] = c;
				gi += vw;
				y += 1;
			}
		} else {
			while (y < cy0) {
				pix[gi] = ceilp[y];
				gi += vw;
				y += 1;
			}
			while (y < cy1) {
				pix[gi] = strip[tacc >> 11];
				tacc += tstep;
				gi += vw;
				y += 1;
			}
			while (y < vh) {
				pix[gi] = floorp[y];
				gi += vw;
				y += 1;
			}
		}
	}
}

// half mode: fg = top pixel, bg = bottom pixel, upper-half-block glyph
def rows_half(pix) {
	var vw = G.vw;
	var fgs := PAL_FG;
	var bgs := PAL_BG;
	var hb = HALFG;
	var reset = RESET;
	var rows = [];
	var vrows = G.vh / 2;
	for (var ry = 0; ry < vrows; ++ry) {
		var row = "";
		var ptop = -1;
		var pbot = -1;
		var itop = ry * 2 * vw;
		var ibot = itop + vw;
		for (var x = 0; x < vw; ++x) {
			var tc = pix[itop + x];
			var bc = pix[ibot + x];
			if (tc != ptop) { row += fgs[tc]; ptop = tc; }
			if (bc != pbot) { row += bgs[bc]; pbot = bc; }
			row += hb;
		}
		row += reset;
		rows.push_back(row);
	}
	return rows;
}

// quad mode: 2x2 pixels per cell, two colors by luminosity partition
def rows_quad(pix) {
	var vw = G.vw;
	var fgs := PAL_FG;
	var bgs := PAL_BG;
	var lums := PAL_LUM;
	var qg := QUADG;
	var reset = RESET;
	var rows = [];
	var vrows = G.vh / 2;
	var cells = vw / 2;
	for (var ry = 0; ry < vrows; ++ry) {
		var row = "";
		var pfg = -1;
		var pbg = -1;
		var itop = ry * 2 * vw;
		var ibot = itop + vw;
		for (var cx = 0; cx < cells; ++cx) {
			var xx = cx * 2;
			var p0 = pix[itop + xx];
			var p1 = pix[itop + xx + 1];
			var p2 = pix[ibot + xx];
			var p3 = pix[ibot + xx + 1];
			if (p0 == p1 && p0 == p2 && p0 == p3) {
				if (p0 != pbg) { row += bgs[p0]; pbg = p0; }
				row += " ";
				continue;
			}
			// wall slices split cells into vertical or horizontal halves far
			// more often than not — cheap two-color paths before the full
			// luminosity partition
			if (p0 == p2 && p1 == p3) {
				if (p0 != pfg) { row += fgs[p0]; pfg = p0; }
				if (p1 != pbg) { row += bgs[p1]; pbg = p1; }
				row += qg[5];                 // left half
				continue;
			}
			if (p0 == p1 && p2 == p3) {
				if (p0 != pfg) { row += fgs[p0]; pfg = p0; }
				if (p2 != pbg) { row += bgs[p2]; pbg = p2; }
				row += qg[3];                 // upper half
				continue;
			}
			var l0 = lums[p0];
			var l1 = lums[p1];
			var l2 = lums[p2];
			var l3 = lums[p3];
			var lmin = l0;
			var lmax = l0;
			var fgp = p0;
			var bgp = p0;
			if (l1 < lmin) { lmin = l1; bgp = p1; }
			if (l1 > lmax) { lmax = l1; fgp = p1; }
			if (l2 < lmin) { lmin = l2; bgp = p2; }
			if (l2 > lmax) { lmax = l2; fgp = p2; }
			if (l3 < lmin) { lmin = l3; bgp = p3; }
			if (l3 > lmax) { lmax = l3; fgp = p3; }
			var thr = (lmin + lmax + 1) / 2;
			var bits = 0;
			if (l0 >= thr) { bits = 1; }
			if (l1 >= thr) { bits += 2; }
			if (l2 >= thr) { bits += 4; }
			if (l3 >= thr) { bits += 8; }
			if (fgp != pfg) { row += fgs[fgp]; pfg = fgp; }
			if (bits != 15 && bgp != pbg) { row += bgs[bgp]; pbg = bgp; }
			row += qg[bits];
		}
		row += reset;
		rows.push_back(row);
	}
	return rows;
}

// sext mode: 2x3 pixels per cell (Unicode 13 "Symbols for Legacy Computing")
def rows_sext(pix) {
	var vw = G.vw;
	var fgs := PAL_FG;
	var bgs := PAL_BG;
	var lums := PAL_LUM;
	var sg := SEXTG;
	var reset = RESET;
	var rows = [];
	var vrows = G.vh / 3;
	var cells = vw / 2;
	for (var ry = 0; ry < vrows; ++ry) {
		var row = "";
		var pfg = -1;
		var pbg = -1;
		var r0 = ry * 3 * vw;
		var r1 = r0 + vw;
		var r2 = r1 + vw;
		for (var cx = 0; cx < cells; ++cx) {
			var xx = cx * 2;
			var p0 = pix[r0 + xx];
			var p1 = pix[r0 + xx + 1];
			var p2 = pix[r1 + xx];
			var p3 = pix[r1 + xx + 1];
			var p4 = pix[r2 + xx];
			var p5 = pix[r2 + xx + 1];
			if (p0 == p1 && p0 == p2 && p0 == p3 && p0 == p4 && p0 == p5) {
				if (p0 != pbg) { row += bgs[p0]; pbg = p0; }
				row += " ";
				continue;
			}
			var l0 = lums[p0];
			var l1 = lums[p1];
			var l2 = lums[p2];
			var l3 = lums[p3];
			var l4 = lums[p4];
			var l5 = lums[p5];
			var lmin = l0;
			var lmax = l0;
			var fgp = p0;
			var bgp = p0;
			if (l1 < lmin) { lmin = l1; bgp = p1; }
			if (l1 > lmax) { lmax = l1; fgp = p1; }
			if (l2 < lmin) { lmin = l2; bgp = p2; }
			if (l2 > lmax) { lmax = l2; fgp = p2; }
			if (l3 < lmin) { lmin = l3; bgp = p3; }
			if (l3 > lmax) { lmax = l3; fgp = p3; }
			if (l4 < lmin) { lmin = l4; bgp = p4; }
			if (l4 > lmax) { lmax = l4; fgp = p4; }
			if (l5 < lmin) { lmin = l5; bgp = p5; }
			if (l5 > lmax) { lmax = l5; fgp = p5; }
			var thr = (lmin + lmax + 1) / 2;
			var bits = 0;
			if (l0 >= thr) { bits = 1; }
			if (l1 >= thr) { bits += 2; }
			if (l2 >= thr) { bits += 4; }
			if (l3 >= thr) { bits += 8; }
			if (l4 >= thr) { bits += 16; }
			if (l5 >= thr) { bits += 32; }
			if (fgp != pfg) { row += fgs[fgp]; pfg = fgp; }
			if (bits != 63 && bgp != pbg) { row += bgs[bgp]; pbg = bgp; }
			row += sg[bits];
		}
		row += reset;
		rows.push_back(row);
	}
	return rows;
}

// world -> camera -> screen; appends [depth, scx, art, size, zlift, flash, wx, wy]
def collect_billboard(sp, wx, wy, art, size, zlift, flash, inv, dirx, diry, planex, planey, px, py) {
	var rx = wx - px;
	var ry = wy - py;
	var depth = inv * (planex * ry - planey * rx);
	if (depth < 0.18 || depth > 15.0) { return; }
	var ttx = inv * (diry * rx - dirx * ry);
	var scx = itrunc((G.vw / 2.0) * (1.0 + ttx / depth));
	if (scx < -G.vw || scx > G.vw * 2) { return; }
	sp.push_back([depth, scx, art, size, zlift, flash, wx, wy]);
}

def draw_billboard(rec, pix, zbuf) {
	var depth = rec[0];
	var scx = rec[1];
	var name = rec[2];
	var size = rec[3];
	var zlift = rec[4];
	var flash = rec[5];
	var art := ARTS[name];
	var aw = art["w"];
	var ah = art["h"];
	var apix := art["pix"];
	var vw = G.vw;
	var vh = G.vh;
	var span = 1.0 * vh / depth;
	var ph = itrunc(span * size);
	if (ph < 2) { ph = 2; }
	// pixel aspect: a cell is ~1:2 (w:h) split into PIXW x PIXH
	var pw = ph * aw * 2 * PIXW / (ah * PIXH);
	if (pw < 2) { pw = 2; }
	var band = itrunc(depth * 85e-2) - (G.muzzle > 0 ? 1 : 0);
	band = band < 0 ? 0 : (band > 7 ? 7 : band);
	var lut := sprite_lut(name, band, flash, SHOWCASE ? G.lights.at(rec[6], rec[7]) : 0);
	var bottom = itrunc((SHOWCASE ? HORIZON : vh / 2) + span * 0.5 - zlift * span);
	var top = bottom - ph;
	var x0 = scx - pw / 2;
	var x1 = x0 + pw;
	var cx0 = x0 < 0 ? 0 : x0;
	var cx1 = x1 > vw ? vw : x1;
	var cy0 = top < 0 ? 0 : top;
	var cy1 = bottom > vh ? vh : bottom;
	for (var x = cx0; x < cx1; ++x) {
		if (depth >= zbuf[x]) { continue; }
		var ax = (x - x0) * aw / pw;
		for (var y = cy0; y < cy1; ++y) {
			var ay = (y - top) * ah / ph;
			var code = apix[ay * aw + ax];
			if (code > 0) { pix[y * vw + x] = lut[code]; }
		}
	}
}

// arcade automap: square tiles, walls in kind colors, live blips
def draw_automap(pix) {
	var vw = G.vw;
	var mw = G.mw;
	var mh = G.mh;
	var sx = PIXW * 2;
	var sy = PIXH;
	var ox = sx * 2;
	var oy = sy * 2;
	var kc := AM_COLS;
	var tiles := G.tiles;
	for (var ty = 0; ty < mh; ++ty) {
		for (var tx = 0; tx < mw; ++tx) {
			var t = tiles[ty * mw + tx];
			var c = t == 0 ? AM_FLOOR : kc[t];
			if (t == 6 && (G.tick & 8) == 0) { c = AM_BLINK; }
			var bx = ox + tx * sx;
			var by = oy + ty * sy;
			for (var yy = 0; yy < sy; ++yy) {
				var rb = (by + yy) * vw + bx;
				for (var xx = 0; xx < sx; ++xx) { pix[rb + xx] = c; }
			}
		}
	}
	// blips: items gold, live enemies red, you white (+ heading pixel)
	var nitems = vlen(G.items);
	for (var i = 0; i < nitems; ++i) {
		var it := G.items[i];
		if (it[3] == 1) { continue; }
		blip(pix, ox + itrunc(it[1]) * sx, oy + itrunc(it[2]) * sy, AM_ITEM);
	}
	for (e : G.enemies) {
		if (!e.alive) { continue; }
		blip(pix, ox + itrunc(e.x) * sx, oy + itrunc(e.y) * sy, AM_ENEMY);
	}
	blip(pix, ox + itrunc(G.px) * sx, oy + itrunc(G.py) * sy, AM_SELF);
	blip(pix, ox + itrunc(G.px + cos(G.pang) * 1.4) * sx, oy + itrunc(G.py + sin(G.pang) * 1.4) * sy, AM_HEAD);
}

def blip(pix, bx, by, c) {
	var vw = G.vw;
	var vh = G.vh;
	if (bx < 0 || by < 0 || bx + 1 >= vw || by + 1 >= vh) { return; }
	pix[by * vw + bx] = c;
	pix[by * vw + bx + 1] = c;
	pix[(by + 1) * vw + bx] = c;
	pix[(by + 1) * vw + bx + 1] = c;
}

// ------------------------------------------------------- the showcase look --
// Its view casts one ray per pixel column, then paints each column top to
// bottom: textured ceiling, the lit wall slice, textured floor with its stains.
// Every surface reads its light texel and a lit table (look.chai, lights.chai).
global HORIZON = 0     // the pixel row the eye looks along: vh / 2, moved by bob and shake
global LWALL = []      // [kind][variant][side][shade][tone]
global LFLOOR = []     // [variant][shade][tone]
global LCEIL = []
global WALLTEX = []    // wall tones [far][kind][ty][tx]
global FLOORTEX = []   // floor tones [far][variant][v][u]
global CEILTEX = []
global FLOOR_VAR = []  // per tile: which floor variant, times 256
global CEIL_VAR = []   // per tile: 256 under a lamp
global STAINS = []     // per tile 8x8 decal tones, 0 none
global ROWD = []       // per pixel row: floor or ceiling distance
global ROWS_SHADE = []
global ROWS_FAR = []   // per pixel row: 1 past FAR_TEXTURE

// the showcase look's lit tables, textures and lamps for floor mi
def build_showcase_tables(mi) {
	LWALL = showcase_lit_wall_tones(mi);
	LFLOOR = showcase_floor_tones(mi);
	LCEIL = showcase_ceiling_tones(mi);
	WALLTEX = showcase_wall_texture();
	FLOORTEX = showcase_floor_texture(mi);
	CEILTEX = showcase_ceiling_texture();
	G.lights.load();
	var lamps := G.lights.lamps;
	var mw = G.mw;
	var mh = G.mh;
	FLOOR_VAR = [];
	CEIL_VAR = [];
	STAINS = [];
	for (var ty = 0; ty < mh; ++ty) {
		for (var tx = 0; tx < mw; ++tx) {
			FLOOR_VAR.push_back((texel_noise(31, tx, ty) & 3) * 256);
			CEIL_VAR.push_back(lamps[ty * mw + tx] ? 256 : 0);
		}
	}
	for (var i = 0; i < mw * mh * 64; ++i) { STAINS.push_back(0); }
	ROWD = [];
	ROWS_SHADE = [];
	ROWS_FAR = [];
	for (var y = 0; y < G.vh; ++y) {
		ROWD.push_back(0.0);
		ROWS_SHADE.push_back(0);
		ROWS_FAR.push_back(0);
	}
}

def showcase_view(pix, zb, px, py, dirx, diry, planex, planey) {
	var vw = G.vw;
	var vh = G.vh;
	HORIZON = vh / 2 + G.feel.pitch;
	G.lights.frame(G.feel.sources);

	// the floor or ceiling distance and shade of every pixel row
	var hz = 0.0 + HORIZON;
	var rowd := ROWD;
	var rshade := ROWS_SHADE;
	var rfar := ROWS_FAR;
	var far_texture = FAR_TEXTURE;
	for (var y = 0; y < vh; ++y) {
		var k = y + 0.5 - hz;
		if (k < 0.0) { k = 0.0 - k; }
		var d = k > 0.3 ? vh / (2.0 * k) : 60.0;
		rowd[y] = d;
		var shade = 15 - itrunc(d * 1.55);
		rshade[y] = shade < 0 ? 0 : shade;
		rfar[y] = d > far_texture ? 1 : 0;
	}

	var lg := G.lights.grid;
	var gw = G.lights.gw;
	var mw = G.mw;
	var walls := LWALL;
	var floors := LFLOOR;
	var ceilings := LCEIL;
	var wtex := WALLTEX;
	var ftex := FLOORTEX;
	var ctex := CEILTEX;
	var fvar := FLOOR_VAR;
	var cvar := CEIL_VAR;
	var stain := STAINS;
	var wall_stride = WALL_TABLE_STRIDE;
	var floor_tones = FLOOR_TONES;
	var xstep = 2.0 / (vw - 1.0);
	for (var x = 0; x < vw; ++x) {
		var camx = x * xstep - 1.0;
		var rdx = dirx + planex * camx;
		var rdy = diry + planey * camx;
		cast_wall_ray(px, py, rdx, rdy);
		var dist = RAY_D;
		var side = RAY_S;
		var kind = RAY_K;
		var tx = RAY_T >> 1;
		zb[x] = dist;
		// the wall's rows are those whose centers lie within half of the horizon,
		// so every ceiling and floor pixel is strictly nearer than the wall
		var half = 0.5 * vh / dist;
		var ytop = hz - half;
		var y0 = 0 - itrunc(floor(0.5 - ytop));
		var y1 = itrunc(floor(hz - 0.5 + half)) + 1;
		var cy0 = y0 < 0 ? 0 : (y0 > vh ? vh : y0);
		var cy1 = y1 > vh ? vh : (y1 < cy0 ? cy0 : y1);

		// ceiling
		var gi = x;
		for (var y = 0; y < cy0; ++y) {
			var d = rowd[y];
			var fx = px + rdx * d;
			var fy = py + rdy * d;
			var ix = itrunc(fx);
			var iy = itrunc(fy);
			var u = itrunc((fx - ix) * 16.0);
			var v = itrunc((fy - iy) * 16.0);
			var lx = itrunc(fx * 4.0);
			var ly = itrunc(fy * 4.0);
			var tone = ctex[rfar[y] * 512 + cvar[iy * mw + ix] + v * 16 + u];
			pix[gi] = ceilings[(lg[ly * gw + lx] * 16 + rshade[y]) * 8 + tone];
			gi += vw;
		}

		// wall
		var shade = 15 - itrunc(dist * 1.55);
		shade = shade < 0 ? 0 : (shade > 15 ? 15 : shade);
		var back = dist - 0.03;
		var wlx = itrunc((px + rdx * back) * 4.0);
		var wly = itrunc((py + rdy * back) * 4.0);
		var light = lg[wly * gw + wlx];
		var wbase = kind * wall_stride + ((light * 2 + side) * 16 + shade) * 8;
		var tbase = (dist > far_texture ? 9216 : 0) + kind * 1024 + tx;
		var tscale = 65536.0 / (2.0 * half);
		var tstep = itrunc(tscale);
		var tacc = itrunc((cy0 + 0.5 - ytop) * tscale);
		gi = cy0 * vw + x;
		for (var y = cy0; y < cy1; ++y) {
			pix[gi] = walls[wbase + wtex[tbase + ((tacc >> 11) & 31) * 32]];
			tacc += tstep;
			gi += vw;
		}

		// floor
		for (var y = cy1; y < vh; ++y) {
			var d = rowd[y];
			var fx = px + rdx * d;
			var fy = py + rdy * d;
			var ix = itrunc(fx);
			var iy = itrunc(fy);
			var u = itrunc((fx - ix) * 16.0);
			var v = itrunc((fy - iy) * 16.0);
			var lx = itrunc(fx * 4.0);
			var ly = itrunc(fy * 4.0);
			var ti = iy * mw + ix;
			var tone = stain[ti * 64 + (v >> 1) * 8 + (u >> 1)];
			if (tone == 0) { tone = ftex[rfar[y] * 1024 + fvar[ti] + v * 16 + u]; }
			pix[gi] = floors[(lg[ly * gw + lx] * 16 + rshade[y]) * floor_tones + tone];
			gi += vw;
		}
	}
}

// a decal on the floor: tone over the texels within radius of (x, y), each kept with chance keep/256
def stain_floor(x, y, radius, tone, keep) {
	var mw = G.mw;
	var tiles := G.tiles;
	var stains := STAINS;
	var x0 = itrunc((x - radius) * 8.0);
	var x1 = itrunc((x + radius) * 8.0);
	var y0 = itrunc((y - radius) * 8.0);
	var y1 = itrunc((y + radius) * 8.0);
	var r2 = radius * radius * 64.0;
	var ye = imin(G.mh * 8 - 1, y1);
	var xe = imin(mw * 8 - 1, x1);
	for (var sy = imax(0, y0); sy <= ye; ++sy) {
		for (var sx = imax(0, x0); sx <= xe; ++sx) {
			var dx = sx + 0.5 - x * 8.0;
			var dy = sy + 0.5 - y * 8.0;
			if (dx * dx + dy * dy > r2) { continue; }
			if ((texel_noise(41, sx, sy) & 255) >= keep) { continue; }
			var tile = (sy >> 3) * mw + (sx >> 3);
			if (tiles[tile] != 0) { continue; }
			var i = tile * 64 + (sy & 7) * 8 + (sx & 7);
			var old = stains[i];
			if (tone == TONE_BLOOD && old == TONE_SCORCH) { continue; }
			stains[i] = tone;
		}
	}
}

// old blood dries: one pass a second darkens a slice of the stains
def dry_stains(tick) {
	var stains := STAINS;
	var n = vlen(stains);
	var slice = n / 30 + 1;
	var start = (tick % 30) * slice;
	var stop = imin(n, start + slice);
	for (var i = start; i < stop; ++i) {
		if (stains[i] == TONE_BLOOD && (texel_noise(43, i, tick / 30) & 7) == 0) { stains[i] = TONE_BLOOD_DRY; }
	}
}

// the showcase look's gun in hand: sways with the walk, kicks on each shot
def draw_viewmodel(pix) {
	if (G.automap) { return; }
	var firing = G.cooldown > WEAPONS[G.weapon]["cd"] - 4 || G.gun_kick > 0;
	var name = VIEWMODEL_NAMES[G.weapon];
	if (firing && G.muzzle > 0) { name = name + "_fire"; }
	var art := VIEWMODELS[name];
	var lut := viewmodel_lut(name, G.muzzle > 0, G.lights.at(G.px, G.py));
	var vw = G.vw;
	var vh = G.vh;
	var aw = art["w"];
	var ah = art["h"];
	var apix := art["pix"];
	// art pixels are square: a view pixel is PIXW x PIXH of a 1:2 cell
	var scale = vh * 0.4 / 24.0;
	var ph = itrunc(ah * scale);
	var pw = ph * aw * 2 * PIXW / (ah * PIXH);
	var sway = itrunc(sin(G.bob * 0.5) * vw * 0.025);
	var lift = itrunc(fabs(cos(G.bob * 0.5)) * scale * 1.5) + G.gun_kick * itrunc(scale * 0.9);
	var x0 = vw / 2 - pw / 2 + sway;
	var y0 = vh - ph + lift + (HORIZON - vh / 2) / 2;
	var cx0 = imax(0, x0);
	var cx1 = imin(vw, x0 + pw);
	var cy1 = imin(vh, y0 + ph);
	for (var y = imax(0, y0); y < cy1; ++y) {
		var row = ((y - y0) * ah / ph) * aw;
		var base = y * vw;
		for (var x = cx0; x < cx1; ++x) {
			var code = apix[row + (x - x0) * aw / pw];
			if (code > 0) { pix[base + x] = lut[code]; }
		}
	}
}

// palette code -> index for a gun under this floor's light, brighter in its own flash
def viewmodel_lut(name, flashing, variant) {
	var key = "${name}:${flashing}:${variant}";
	if (G.lutc.count(key) != 0) { return G.lutc[key]; }
	var mood := MOODS[G.map_i];
	var art := VIEWMODELS[name];
	var light = cadd(cscale(mix_rgb(mood["light"], rgb(255, 255, 255), 0.4), flashing ? 1.25 : 0.7), cscale(sprite_light(mood, variant), 0.8));
	var rgbs := art["rgb"];
	var keys := art["keys"];
	var lut = [0];
	var nc = vlen(rgbs);
	for (var c = 1; c < nc; ++c) {
		var color = rgb(rgbs[c][0], rgbs[c][1], rgbs[c][2]);
		var key_char = keys[c];
		if (key_char >= "A" && key_char <= "Z") { lut.push_back(color_idx(color)); }
		else { lut.push_back(color_idx(cclamp(cmul(color, light)))); }
	}
	G.lutc[key] = lut;
	return lut;
}
