// The showcase look's status bar, panel and full-screen pages (title, floor
// tally, death, victory), painted on half-block canvases. hud.chai keeps the
// reference look's versions, the frames --smoke hashes.

// the face in the panel: 10x10 pixel art, one per expression (face_name)
global FACE_PAL = ["h": [58, 40, 30], "s": [214, 160, 120], "S": [156, 106, 78], "e": [240, 236, 226], "p": [34, 30, 40],
	"B": [70, 44, 30], "m": [96, 30, 30], "t": [236, 228, 210], "b": [186, 26, 22], "g": [150, 150, 140], "x": [40, 20, 20]]
global FACE_SRC = [
	"ok":   ["..hhhhhh..", ".hhhhhhhh.", ".hsssssshh", ".sBBssBBsh", ".sepssepsS",
	         ".sssSsssss", ".ssSSSssS.", ".ssmmmmsS.", "..ssssss..", "...SSSS..."],
	"hurt": ["..hhhhhh..", ".hhhhhhhh.", ".hsssssshh", ".sBBssBBsh", ".sepssepsS",
	         ".sssSssSSs", ".ssSSSsSS.", ".ssmmmmsS.", "..sSssss..", "...SSSS..."],
	"bad":  ["..hhhhhh..", ".hhbhhhhh.", ".hsbsssshh", ".sBBssBBsh", ".sxxsseps.",
	         ".bssSssSSs", ".bsSSSsSS.", ".ssmmmmsS.", "..sSsSss..", "...SSSS..."],
	"crit": ["..hhbhhh..", ".hhbbhhhh.", ".hbbsbsshh", ".sBBbsBBsh", ".sxxssxxb.",
	         ".bbsSssSbs", ".bsSSSsbS.", ".sbttttbS.", "..sbsSsb..", "...SbSS..."],
	"pain": ["..hhhhhh..", ".hhhhhhhh.", ".hsBBsBBhh", ".sssssssh.", ".sxxssxxs.",
	         ".sssSsssss", ".ssmmmmsS.", ".ssmttmsS.", "..smmmms..", "...SSSS..."],
	"grin": ["..hhhhhh..", ".hhhhhhhh.", ".hsssssshh", ".sBBssBBsh", ".sepssepsS",
	         ".sssSsssss", ".smSSSSms.", ".sttttttS.", "..smmmms..", "...SSSS..."],
	"dead": ["..hhhhhh..", ".hhhbhhhh.", ".hgggggghh", ".gxgggxgg.", ".ggxggxgg.",
	         ".gxgggxgg.", ".gggSgggg.", ".ggxxxxgb.", "..gggggb..", "...gggb..."]
]

// the logo, 57 x 11 pixels: G L O O M
global LOGO_ART = [
	"..######....###...........######......######....###....###",
	".########...###..........########....########...####..####",
	"###....###..###.........###....###..###....###..##.####.##",
	"##..........###.........##......##..##......##..##..##..##",
	"##..........###.........##......##..##......##..##......##",
	"##...#####..###.........##......##..##......##..##......##",
	"##...#####..###.........##......##..##......##..##......##",
	"##......##..###.........##......##..##......##..##......##",
	"###....###..###.........###....###..###....###..##......##",
	".########...#########....########....########...##......##",
	"..######....#########.....######......######....##......##"
]

class Screens {
	var panel          // the six rows under the view
	var page           // a whole-screen page
	var faces
	var face_luts
	var heat           // the title's fire
	var fire_colors
	var fire_tick

	def Screens(w, h) {
		this.panel = Canvas(w, 6);
		this.page = Canvas(w, h);
		this.faces = Map();
		this.face_luts = Map();
		for (kv : FACE_SRC) {
			// a map literal passed straight in arrives const, and ChaiScript's Map has no const []
			var src = ["pal": FACE_PAL, "rows": FACE_SRC[kv.first]];
			var art = parse_art(src);
			this.faces[kv.first] = art;
			this.face_luts[kv.first] = this.plain_lut(art);
		}
		this.heat = [];
		this.fire_colors = [];
		this.fire_tick = -1;
	}

	def frame(fps, ms_sim, ms_draw) {
		G.feel.frame();
		if (G.mode == 0) { return join_all(this.title_page(), "\n"); }
		if (G.mode == 2) { return join_all(this.tally_page(), "\n"); }
		if (G.mode == 3) { return join_all(this.dead_page(), "\n"); }
		if (G.mode == 4) { return join_all(this.victory_page(), "\n"); }
		var rows = render_view();
		for (r : this.hud_rows(fps, ms_sim, ms_draw)) { rows.push_back(r); }
		return join_all(rows, "\n");
	}

	// a code -> palette index table for an art, unshaded
	def plain_lut(a) {
		var lut = [0];
		var rgbs := a["rgb"];
		var n = vlen(rgbs);
		for (var c = 1; c < n; ++c) { lut.push_back(rgb_idx(rgbs[c][0], rgbs[c][1], rgbs[c][2])); }
		return lut;
	}

	// five font-row colors from top to bottom
	def shades5(top, bottom) {
		var out = [];
		for (var i = 0; i < 5; ++i) { out.push_back(color_idx(mix_rgb(top, bottom, i / 4.0))); }
		return out;
	}

	// the status-bar color of a message (show_msg takes an SGR color code)
	def message_color(code) {
		if (code == "91") { return rgb_idx(255, 96, 80); }
		if (code == "92") { return rgb_idx(120, 236, 120); }
		if (code == "93") { return rgb_idx(255, 214, 90); }
		if (code == "94") { return rgb_idx(110, 160, 255); }
		if (code == "96") { return rgb_idx(110, 230, 230); }
		if (code == "90") { return rgb_idx(130, 126, 136); }
		return rgb_idx(240, 236, 228);
	}

	// ---------------------------------------------------------------- HUD ----
	// HUD rows under the view: the status bar, then health, armor, the face, the
	// weapon's ammo and the arms rack with keycards
	def hud_rows(fps, ms_sim, ms_draw) {
		var c := this.panel;
		var w = c.w;
		var mood := MOODS[G.map_i];
		c.clear(rgb_idx(14, 12, 18));
		c.gradient(2, 12, rgb(62, 58, 70), rgb(22, 20, 26));
		c.rect(0, 11, w, 1, rgb_idx(10, 8, 12));

		// status bar: where, how it is going, what just happened
		var dim = rgb_idx(132, 124, 136);
		var map_code = G.map_name.substr(0, 4);
		var map_title = G.map_name.substr(6, slen(G.map_name) - 6);
		c.text(1, 0, map_code, color_idx(mood["light"]));
		c.text(6, 0, map_title, rgb_idx(214, 206, 196));
		var tally = "KILLS ${G.kills}/${G.kill_total}   SECRETS ${G.secrets}/${G.secret_total}";
		var tally_x = 7 + slen(map_title) + 3;
		c.text(tally_x, 0, tally, dim);
		if (G.msg_t > 0) {
			var room = w - (tally_x + slen(tally)) - 3;
			var m = slen(G.msg) > room ? G.msg.substr(0, imax(0, room)) : G.msg;
			c.text_right(w - 1, 0, m, this.message_color(G.msg_color));
		}

		var stat_w = iclamp((w - 33) / 3, 12, 17);
		var x_hp = 1;
		var x_armor = x_hp + stat_w + 1;
		var x_face = x_armor + stat_w + 1;
		var x_ammo = x_face + 13;
		var x_arms = x_ammo + stat_w + 1;
		var sep = rgb_idx(14, 12, 18);
		for (x : [x_armor - 1, x_face - 1, x_ammo - 1, x_arms - 1]) { c.rect(x, 3, 1, 8, sep); }

		var red_digits = this.shades5(rgb(255, 220, 130), rgb(214, 64, 40));
		var blue_digits = this.shades5(rgb(200, 232, 255), rgb(64, 120, 220));
		var gold_digits = this.shades5(rgb(255, 244, 196), rgb(214, 150, 54));
		var hp_bar = G.hp > 100 ? rgb_idx(120, 220, 255) : (G.hp > 60 ? rgb_idx(110, 220, 90) : (G.hp > 30 ? rgb_idx(240, 190, 60) : rgb_idx(240, 60, 40)));
		this.stat_block(c, x_hp, stat_w, "HEALTH", G.hp, imin(G.hp, 100), 100, red_digits, hp_bar);
		this.stat_block(c, x_armor, stat_w, "ARMOR", G.armor, G.armor, 100, blue_digits, rgb_idx(90, 150, 240));

		c.rect(x_face, 2, 12, 10, rgb_idx(18, 16, 22));
		var fname = face_name();
		c.art(this.faces[fname], x_face + 1, 2, this.face_luts[fname]);

		var weapon := WEAPONS[G.weapon];
		var pool = weapon["ammo"];
		var pool_colors = [rgb_idx(226, 186, 84), rgb_idx(226, 96, 64), rgb_idx(90, 230, 220)];
		this.stat_block(c, x_ammo, stat_w, weapon["name"], G.ammo[pool], G.ammo[pool], AMMO_MAX[pool], gold_digits, pool_colors[pool]);

		var arms_w = w - x_arms - 1;
		if (arms_w >= 11) {
			c.text(x_arms + 1, 1, "ARMS", dim);
			for (var slot = 0; slot < 3; ++slot) {
				var sx = x_arms + 1 + slot * 4;
				var owned = G.have[slot] == 1;
				if (slot == G.weapon) { c.rect(sx, 4, 3, 2, rgb_idx(132, 100, 40)); }
				c.text(sx + 1, 2, "${slot + 1}", owned ? rgb_idx(250, 240, 210) : rgb_idx(70, 66, 76));
			}
			if (arms_w >= 26) {
				c.text(x_arms + 14, 2, "B${G.ammo[0]} S${G.ammo[1]} C${G.ammo[2]}", dim);
			}
			this.key_chip(c, x_arms + 1, 3, "RED", G.key_r, rgb_idx(200, 40, 34));
			this.key_chip(c, x_arms + 7, 3, "BLUE", G.key_b, rgb_idx(44, 90, 210));
			if (G.autopilot) { c.text(x_arms + 1, 5, "AUTOPILOT", rgb_idx(110, 230, 230)); }
			else if (fps > 0.0) {
				// fps rounded, total ms with one decimal
				var cores = HOST_WORKERS > 0 ? "  ${HOST_WORKERS} cores" : "";
				var fpsr = itrunc(fps + 0.5);
				var ms10 = itrunc((ms_sim + ms_draw) * 10.0 + 0.5);
				c.text(x_arms + 1, 5, "${fpsr} fps ${ms10 / 10}.${ms10 % 10} ms${cores}", dim);
			}
		}
		return c.rows(0, 6);
	}

	// a labelled big number with a bar beneath it
	def stat_block(c, x, width, label, value, bar, bar_max, digits, bar_color) {
		c.text(x + 1, 1, label, rgb_idx(150, 140, 132));
		var number = "${value}";
		c.lettering(number, x + width - 1 - lettering_width(number, 1), 4, 1, digits, rgb_idx(16, 12, 14));
		var bar_w = width - 2;
		var filled = iclamp(bar * bar_w / imax(1, bar_max), 0, bar_w);
		c.rect(x + 1, 10, bar_w, 1, rgb_idx(40, 36, 44));
		c.rect(x + 1, 10, filled, 1, bar_color);
	}

	def key_chip(c, x, row, name, held, color) {
		if (held) {
			c.rect(x, row * 2, slen(name) + 2, 2, color);
			c.text(x + 1, row, name, rgb_idx(255, 255, 255));
		} else {
			c.text(x + 1, row, name, rgb_idx(76, 70, 82));
		}
	}

	// -------------------------------------------------------------- pages ----
	def ember(i, salt) { return mix32(mix32((0ll + i) * 2654435 + 7, salt), 99991); }

	// the title's fire: each cell takes the average of the cells under it, a little
	// cooler, over a bottom row of flickering embers; one step a tick, the flicker a
	// hash of the tick, so every run burns alike
	def draw_fire(c, rows) {
		var w = c.w;
		var height = c.h * 2;
		if (vlen(this.fire_colors) == 0) {
			var stops = [rgb(0, 0, 0), rgb(40, 6, 6), rgb(120, 16, 8), rgb(196, 48, 10), rgb(236, 110, 20),
				rgb(250, 176, 50), rgb(255, 228, 120), rgb(255, 250, 220)];
			var nstops = vlen(stops);
			for (var i = 0; i < 36; ++i) {
				var t = i / 35.0 * (nstops - 1);
				var k = itrunc(t);
				var k2 = imin(nstops - 1, k + 1);
				this.fire_colors.push_back(color_idx(mix_rgb(stops[k], stops[k2], t - k)));
			}
		}
		if (vlen(this.heat) != w * (rows + 2)) {
			this.heat = [];
			for (var i = 0; i < w * (rows + 2); ++i) { this.heat.push_back(0); }
			this.fire_tick = -1;
		}
		var steps = this.fire_tick < 0 ? rows * 2 : imin(4, G.tick - this.fire_tick);
		var first = this.fire_tick < 0 ? 0 : this.fire_tick;
		for (var s = 0; s < steps; ++s) { this.fire_step(w, rows + 2, first + s); }
		this.fire_tick = G.tick;
		var top = height - rows;
		var heat := this.heat;
		var colors := this.fire_colors;
		var px := c.px;
		for (var y = 0; y < rows; ++y) {
			for (var x = 0; x < w; ++x) {
				var hh = heat[y * w + x] * 35 / 255;
				if (hh > 2) { px[(top + y) * w + x] = colors[hh]; }
			}
		}
	}

	def fire_step(w, rows, tick) {
		var heat := this.heat;
		for (var r = rows - 2; r < rows; ++r) {
			for (var x = 0; x < w; ++x) {
				var n = (mix32(mix32(tick, x), 17 + r) >> 9) & 255;
				heat[r * w + x] = n < 90 ? 60 : 255;
			}
		}
		var cool = 2 + 230 / imax(1, rows);
		for (var y = 0; y < rows - 2; ++y) {
			var row = y * w;
			for (var x = 0; x < w; ++x) {
				var below = row + w + x;
				var left = x > 0 ? heat[below - 1] : heat[below];
				var right = x < w - 1 ? heat[below + 1] : heat[below];
				var hh = (left + heat[below] + right + heat[below + w]) / 4 - cool;
				heat[row + x] = hh < 0 ? 0 : hh;
			}
		}
	}

	// sparks rising from the bottom of the page
	def draw_embers(c, count, hot, cool) {
		var height = c.h * 2;
		var period = height + 16;
		for (var i = 0; i < count; ++i) {
			var speed = 1 + this.ember(i, 1) % 3;
			var x = this.ember(i, 2) % c.w;
			var rise = (G.tick * speed / 2 + this.ember(i, 3) % period) % period;
			var y = height - rise;
			if ((this.ember(i, G.tick / 4) & 3) == 0) { continue; }
			var t = 1.0 * rise / period;
			c.dot(x + ((rise / 6 + i) % 3) - 1, y, color_idx(mix_rgb(hot, cool, t)));
		}
	}

	// a heading in the pixel font, centered at pixel row y, at the largest scale that fits
	def heading(c, s, y, max_scale, top_bottom, shadow) {
		var scale = max_scale;
		while (scale > 1 && lettering_width(s, scale) > c.w - 4) { scale -= 1; }
		c.lettering(s, (c.w - lettering_width(s, scale)) / 2, y, scale, top_bottom, shadow);
		return 5 * scale;
	}

	def blink(period) { return (G.tick / period) % 2 == 0; }

	// outlined, shadowed, lit from above; a bleeding logo gathers drops under its
	// letters that fall
	def draw_logo(c, x, y, top, bottom, bleeding) {
		var lw = slen(LOGO_ART[0]);
		var lh = vlen(LOGO_ART);
		var outline = rgb_idx(6, 2, 4);
		var shadow = rgb_idx(40, 6, 8);
		for (var ly = 0; ly < lh; ++ly) {
			for (var lx = 0; lx < lw; ++lx) {
				if (LOGO_ART[ly].substr(lx, 1) != "#") { continue; }
				c.rect(x + lx - 1, y + ly - 1, 3, 3, outline);
			}
		}
		for (var ly = 0; ly < lh; ++ly) {
			for (var lx = 0; lx < lw; ++lx) {
				if (LOGO_ART[ly].substr(lx, 1) == "#") { c.dot(x + lx + 1, y + ly + 2, shadow); }
			}
		}
		for (var ly = 0; ly < lh; ++ly) {
			var fill = color_idx(mix_rgb(top, bottom, 1.0 * ly / (lh - 1)));
			for (var lx = 0; lx < lw; ++lx) {
				if (LOGO_ART[ly].substr(lx, 1) == "#") { c.dot(x + lx, y + ly, fill); }
			}
		}
		if (!bleeding) { return; }
		var blood = rgb_idx(150, 14, 12);
		var drop = rgb_idx(210, 28, 22);
		for (var lx = 0; lx < lw; ++lx) {
			if (LOGO_ART[lh - 1].substr(lx, 1) != "#" || this.ember(lx, 21) % 4 != 0) { continue; }
			var length = 1 + this.ember(lx, 22) % 4;
			c.rect(x + lx, y + lh, 1, length, blood);
			var fall = (G.tick + this.ember(lx, 23) % 60) % 60;
			if (fall < 24) { c.dot(x + lx, y + lh + length + fall / 2, drop); }
		}
	}

	def title_page() {
		var c := this.page;
		c.clear(0);
		var height = c.h * 2;
		var glow_at = height * 3 / 5;
		c.gradient(0, glow_at, rgb(6, 5, 9), rgb(22, 8, 12));
		c.gradient(glow_at, height, rgb(22, 8, 12), rgb(84, 26, 12));
		this.draw_fire(c, height * 2 / 5);
		this.draw_embers(c, c.w / 2, rgb(255, 214, 120), rgb(110, 30, 16));

		var flicker = this.ember(G.tick / 3, 5) % 9 == 0;
		var bone = flicker ? rgb(190, 180, 160) : rgb(248, 238, 216);
		var logo_y = imax(2, height / 2 - 24);
		this.draw_logo(c, (c.w - slen(LOGO_ART[0])) / 2, logo_y, bone, rgb(160, 24, 20), true);
		var row = (logo_y + vlen(LOGO_ART)) / 2 + 4;
		c.text_centered(row, "a terminal raycaster, written in JaiScript", rgb_idx(186, 154, 130));
		if (this.blink(12)) { c.text_centered(row + 3, "-  press FIRE to descend  -", rgb_idx(255, 226, 160)); }
		var keys = rgb_idx(250, 214, 150);
		var words = rgb_idx(150, 132, 126);
		this.controls_line(c, row + 6, ["W S", "move", "A D", "strafe", "LEFT RIGHT", "turn", "SHIFT", "run"], keys, words);
		this.controls_line(c, row + 7, ["SPACE", "fire", "E", "use", "1 2 3", "weapons", "M", "map", "ESC", "quit"], keys, words);
		return c.rows(0, c.h);
	}

	// "key word   key word ..." centered, keys bright, words dim
	def controls_line(c, row, pairs, key_color, word_color) {
		var width = 0;
		var n = vlen(pairs);
		for (var i = 0; i < n; i += 2) { width += slen(pairs[i]) + 1 + slen(pairs[i + 1]) + 4; }
		var x = (c.w - (width - 4)) / 2;
		for (var i = 0; i < n; i += 2) {
			c.text(x, row, pairs[i], key_color);
			x += slen(pairs[i]) + 1;
			c.text(x, row, pairs[i + 1], word_color);
			x += slen(pairs[i + 1]) + 4;
		}
	}

	def clock_text(ticks) {
		var secs = ticks / 30;
		var pad = secs % 60 < 10 ? "0" : "";
		return "${secs / 60}:${pad}${secs % 60}";
	}

	// the intermission: the floor's numbers count up, DOOM style
	def tally_page() {
		var c := this.page;
		c.clear(0);
		var mood := MOODS[G.map_i];
		var height = c.h * 2;
		c.gradient(0, height, mix_rgb(mood["fog"], rgb(0, 0, 0), 0.3), mix_rgb(mood["ceiling"], mood["light"], 12e-2));
		var gold = this.shades5(rgb(255, 246, 200), rgb(220, 150, 60));
		var top = imax(2, height / 2 - 22);
		c.text_centered(top / 2, G.map_name, color_idx(mood["light"]));
		var head_h = this.heading(c, "FLOOR CLEARED", top + 4, 2, gold, rgb_idx(8, 6, 8));
		var row = (top + 4 + head_h) / 2 + 3;
		var counted = G.mode_t * 2;
		var kills = imin(G.kills, counted / 3);
		var secrets = imin(G.secrets, counted / 9);
		var elapsed = imin(G.map_ticks, counted * 40);
		var kp = G.kill_total > 0 ? kills * 100 / G.kill_total : 100;
		var sp = G.secret_total > 0 ? secrets * 100 / G.secret_total : 100;
		var label = rgb_idx(170, 160, 150);
		var value = rgb_idx(255, 236, 190);
		var x = c.w / 2 - 17;
		this.tally_row(c, x, row, "KILLS", "${kills} / ${G.kill_total}", kp, label, value);
		this.tally_row(c, x, row + 2, "SECRETS", "${secrets} / ${G.secret_total}", sp, label, value);
		c.text(x, row + 4, "TIME", label);
		c.text(x + 10, row + 4, this.clock_text(elapsed), value);
		c.text(x + 18, row + 4, "PAR ${this.clock_text(G.par)}", label);
		var done = kills == G.kills && secrets == G.secrets && elapsed == G.map_ticks;
		if (done && this.blink(12)) {
			var next = G.map_i + 1 < vlen(MAPS) ? "press FIRE for the next floor" : "press FIRE to face the dark";
			c.text_centered(row + 8, next, rgb_idx(255, 226, 160));
		}
		return c.rows(0, c.h);
	}

	def tally_row(c, x, row, name, count, percent, label, value) {
		c.text(x, row, name, label);
		c.text(x + 10, row, count, value);
		c.text_right(x + 24, row, "${percent}%", value);
		c.rect(x + 26, row * 2, 10, 2, rgb_idx(40, 34, 40));
		c.rect(x + 26, row * 2, percent / 10, 2, percent == 100 ? rgb_idx(120, 230, 110) : rgb_idx(226, 176, 70));
	}

	def dead_page() {
		var c := this.page;
		c.clear(0);
		var height = c.h * 2;
		c.gradient(0, height, rgb(36, 4, 6), rgb(8, 2, 3));
		// blood runs down from the top, each run at its own pace and to its own depth
		var trail = rgb_idx(96, 8, 8);
		var bead = rgb_idx(214, 34, 28);
		for (var x = 0; x < c.w; ++x) {
			if (this.ember(x, 10) % 3 != 0) { continue; }
			var depth = height / 4 + this.ember(x, 13) % (height / 2);
			var length = imin(depth, G.mode_t * (2 + this.ember(x, 11) % 5) / 6 - this.ember(x, 12) % 12);
			for (var y = 0; y < length; ++y) { c.dot(x, y, y == length - 1 ? bead : trail); }
		}
		var red = this.shades5(rgb(255, 120, 100), rgb(150, 10, 10));
		var top = height / 2 - 14;
		var head_h = this.heading(c, "YOU DIED", top, 2, red, rgb_idx(6, 0, 0));
		var row = (top + head_h) / 2 + 2;
		c.text_centered(row, "slain by ${G.death_cause} on ${G.map_name}", rgb_idx(236, 200, 190));
		c.text_centered(row + 2, "kills ${G.kills}/${G.kill_total}    deaths ${G.deaths}", rgb_idx(170, 130, 126));
		if (G.mode_t > 25 && this.blink(12)) { c.text_centered(row + 5, "press FIRE to rise again", rgb_idx(255, 226, 160)); }
		return c.rows(0, c.h);
	}

	def victory_page() {
		var c := this.page;
		c.clear(0);
		var height = c.h * 2;
		c.gradient(0, height, rgb(10, 8, 14), rgb(70, 52, 20));
		this.draw_embers(c, c.w / 3, rgb(255, 240, 170), rgb(120, 90, 30));
		var top = imax(2, height / 2 - 24);
		this.draw_logo(c, (c.w - slen(LOGO_ART[0])) / 2, top, rgb(255, 250, 220), rgb(214, 140, 40), false);
		var row = (top + vlen(LOGO_ART)) / 2 + 4;
		c.text_centered(row, "T H E   W A R D E N   I S   D O W N", rgb_idx(255, 230, 160));
		var label = rgb_idx(186, 170, 150);
		var x = c.w / 2 - 14;
		c.text(x, row + 3, "EPISODE KILLS", label);
		c.text(x + 18, row + 3, "${G.ep_kills} / ${G.ep_kill_total}", rgb_idx(255, 246, 210));
		c.text(x, row + 4, "SECRETS", label);
		c.text(x + 18, row + 4, "${G.ep_secrets} / ${G.ep_secret_total}", rgb_idx(255, 246, 210));
		c.text(x, row + 5, "TIME", label);
		c.text(x + 18, row + 5, this.clock_text(G.ep_ticks), rgb_idx(255, 246, 210));
		c.text(x, row + 6, "DEATHS", label);
		c.text(x + 18, row + 6, "${G.deaths}", rgb_idx(255, 246, 210));
		c.text_centered(row + 9, "the gloom lifts. for now.      ESC quits", rgb_idx(170, 150, 120));
		return c.rows(0, c.h);
	}
}
