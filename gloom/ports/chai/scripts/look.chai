// The showcase look: floor moods, wall, floor and ceiling textures, the lit
// color tables, sprite shading and particle colors, all built at boot and on
// map load; the renderer's per-pixel work only looks them up. The reference
// look keeps its own tables, so --smoke keeps the frames the ports reproduce.
//
// A color is [r, g, b] of ChaiScript floats (binary32, like math::color): a
// float op float is a binary32 op and float(x) rounds a double to nearest.
// Alpha is left out: it is 1 everywhere and no table reads it.

global SHOWCASE = false   // gloom_boot: HOST_LOOK == "showcase"

// ------------------------------------------------------------------ tune ----
// how much of a floor's mood light reaches a surface with no lamp over it
global AMBIENT = 34e-2
// lamps hang over every few tiles of open floor and light a pool beneath them
global LAMP_RADIUS = 3.2
global LAMP_POWER = 1.0
global LAMP_SPACING = 5
// the muzzle flash, projectiles and blasts carry their own light
global MUZZLE_RADIUS = 4.6
global SHOT_RADIUS = 2.6
global BLAST_RADIUS = 4.2
global LIGHT_GAIN = 1.35
// camera feel
global BOB_PIXELS = 1.6
global SHAKE = 1.0
global VIGNETTE = 0.55

// ---------------------------------------------------------------- colors ----
def rgb(r, g, b) { return [float(r / 255.0), float(g / 255.0), float(b / 255.0)]; }

def color_of(r, g, b) { return [float(r), float(g), float(b)]; }

// color * scalar: the scalar rounds to binary32 first
def cscale(c, s) {
	var k = float(s);
	return [c[0] * k, c[1] * k, c[2] * k];
}

def cadd(a, b) { return [a[0] + b[0], a[1] + b[1], a[2] + b[2]]; }

def cmul(a, b) { return [a[0] * b[0], a[1] * b[1], a[2] * b[2]]; }

// a + (b - a) * t per channel in double, then one rounding
def mix_rgb(a, b, t) {
	var ar = double(a[0]);
	var ag = double(a[1]);
	var ab = double(a[2]);
	return [float(ar + (double(b[0]) - ar) * t), float(ag + (double(b[1]) - ag) * t), float(ab + (double(b[2]) - ab) * t)];
}

def clamp01(x) { return x < 0.0 ? float(0.0) : (x > 1.0 ? float(1.0) : x); }

def cclamp(c) { return [clamp01(c[0]), clamp01(c[1]), clamp01(c[2])]; }

def color_idx(c) {
	return rgb_idx(itrunc(c[0] * 255.0 + 0.5), itrunc(c[1] * 255.0 + 0.5), itrunc(c[2] * 255.0 + 0.5));
}

// light channels: lamp (the floor's own mood light), fire, hex, acid, red lock, blue lock
global LIGHT_COLORS = [
	color_of(1.0, 86e-2, 0.62),
	color_of(1.0, 0.56, 0.18),
	color_of(0.36, 86e-2, 1.0),
	color_of(0.46, 1.0, 0.36),
	color_of(1.0, 0.18, 12e-2),
	color_of(0.22, 42e-2, 1.0)
]

// A floor's lighting: the torchlight that tints what is near, the haze that
// distance fades into, the tint a wall turned away from the light takes, and
// the surfaces themselves.
def mood(light, fog, turned, ceiling, floor_, walls) {
	return ["light": light, "fog": fog, "turned": turned, "ceiling": ceiling, "floor": floor_, "walls": walls];
}

global MOODS = [
	// E1M1: torchlit sandstone, violet shadows
	mood(rgb(255, 230, 196), rgb(22, 16, 26), rgb(120, 110, 170), rgb(58, 46, 54), rgb(96, 80, 60),
		[rgb(156, 136, 112), rgb(108, 128, 92), rgb(104, 110, 136), rgb(152, 100, 80)]),
	// E1M2: coolant glow, teal haze
	mood(rgb(190, 236, 255), rgb(6, 20, 26), rgb(70, 120, 150), rgb(26, 46, 56), rgb(44, 70, 72),
		[rgb(100, 140, 152), rgb(84, 112, 164), rgb(104, 152, 116), rgb(136, 114, 152)]),
	// E1M3: furnace heat, ember haze
	mood(rgb(255, 196, 140), rgb(34, 12, 8), rgb(150, 70, 60), rgb(70, 34, 24), rgb(86, 60, 42),
		[rgb(176, 114, 70), rgb(144, 86, 118), rgb(132, 124, 72), rgb(96, 130, 140)]),
	// E1M4: the throne's red dark
	mood(rgb(255, 170, 150), rgb(30, 6, 8), rgb(110, 40, 70), rgb(58, 18, 20), rgb(70, 42, 36),
		[rgb(176, 72, 58), rgb(122, 54, 48), rgb(154, 130, 78), rgb(92, 66, 80)])
]

// Wall texels name one of eight tones; a tone is a color per (side, shade).
global TONE_BASE = 0
global TONE_ACCENT = 1
global TONE_GAP = 2
global TONE_LIT_EDGE = 3
global TONE_DARK_EDGE = 4
global TONE_GLOW = 5      // emissive: lamps and lock lights stay bright in the dark
global TONE_GRIT_DARK = 6
global TONE_GRIT_LIGHT = 7

// the surfaces every floor shares: [base, accent, glow] for door, exit switch, red door, blue door
global FIXTURES = [
	[rgb(128, 108, 90), rgb(170, 144, 110), rgb(255, 210, 140)],
	[rgb(62, 66, 60), rgb(226, 190, 60), rgb(110, 255, 130)],
	[rgb(118, 62, 56), rgb(176, 92, 72), rgb(255, 70, 50)],
	[rgb(62, 76, 124), rgb(94, 114, 176), rgb(80, 156, 255)]
]

// distance shade 0 (far) .. 15 (near) -> light reaching the wall
def shade_light(shade) {
	var t = shade / 15.0;
	return 0.05 + 0.8 * t * sqrt(t);
}

// deterministic texel noise: 0..255
def texel_noise(kind, tx, ty) {
	return mix32(mix32(kind * 7919 + 17, tx), ty * 31 + kind) & 255;
}

def grit(kind, tx, ty) {
	var n = texel_noise(kind, tx, ty);
	if (n < 26) { return TONE_GRIT_DARK; }
	if (n > 236) { return TONE_GRIT_LIGHT; }
	return TONE_BASE;
}

// the showcase texture of a wall kind: tone at texel (tx, ty), both 0..31
def showcase_tone(kind, tx, ty) {
	if (kind == 1) { return stone_tone(tx, ty); }
	if (kind == 2) { return panel_tone(tx, ty); }
	if (kind == 3) { return conduit_tone(tx, ty); }
	if (kind == 4) { return block_tone(tx, ty); }
	if (kind == 6) { return switch_tone(tx, ty); }
	if (kind >= 5) { return door_tone(kind, tx, ty); }
	return TONE_BASE;
}

// staggered bricks, eight texels tall
def stone_tone(tx, ty) {
	var row = ty >> 3;
	var y = ty & 7;
	var x = (tx + (row & 1) * 8) & 15;
	if (y == 7 || x == 15) { return TONE_GAP; }
	if (y == 0 || x == 0) { return TONE_LIT_EDGE; }
	if (y == 6) { return TONE_DARK_EDGE; }
	if (((row * 5 + ((tx + (row & 1) * 8) >> 4)) % 3) == 0) { return TONE_ACCENT; }
	return grit(1, tx, ty);
}

// riveted plates with a painted band
def panel_tone(tx, ty) {
	var x = tx & 15;
	var y = ty & 15;
	if (x == 15 || y == 15) { return TONE_GAP; }
	if (x == 0 || y == 0) { return TONE_LIT_EDGE; }
	if (x == 14 || y == 14) { return TONE_DARK_EDGE; }
	if ((x == 2 || x == 12) && (y == 2 || y == 12)) { return TONE_LIT_EDGE; }
	if ((x == 2 || x == 12) && (y == 3 || y == 13)) { return TONE_DARK_EDGE; }
	if (y >= 6 && y <= 8) { return TONE_ACCENT; }
	return grit(2, tx, ty);
}

// runs of pipe held by brackets
def conduit_tone(tx, ty) {
	var y = ty & 7;
	if ((tx & 15) < 2) {
		if (y == 0) { return TONE_LIT_EDGE; }
		return (tx & 15) == 0 ? TONE_ACCENT : TONE_DARK_EDGE;
	}
	if (y == 0) { return TONE_LIT_EDGE; }
	if (y == 5) { return TONE_DARK_EDGE; }
	if (y >= 6) { return TONE_GAP; }
	if (y == 1) { return TONE_ACCENT; }
	return grit(3, tx, ty);
}

// rough cut blocks, cracked and mossy
def block_tone(tx, ty) {
	var row = ty >> 4;
	var y = ty & 15;
	var x = (tx + row * 11) & 31;
	if (y == 15 || x == 31) { return TONE_GAP; }
	if (y == 0 || x == 0) { return TONE_LIT_EDGE; }
	if (y == 14 || x == 30) { return TONE_DARK_EDGE; }
	var n = texel_noise(4, tx, ty);
	if ((tx + ty * 2 + n % 3) % 23 == 0) { return TONE_GAP; }
	if (y > 9 && n % 5 == 0) { return TONE_ACCENT; }
	return grit(4, tx, ty);
}

// a framed door of planks, banded, with a handle; keyed doors carry lock lights
def door_tone(kind, tx, ty) {
	if (tx < 2 || tx > 29 || ty < 1) { return TONE_DARK_EDGE; }
	if (ty > 29) { return TONE_GAP; }
	if (tx == 2 || tx == 29 || ty == 1) { return TONE_LIT_EDGE; }
	if (tx == 15 || tx == 16) { return TONE_GAP; }
	if (kind != 5 && (tx == 6 || tx == 7 || tx == 24 || tx == 25) && ty > 4 && ty < 27) { return TONE_GLOW; }
	if (ty == 7 || ty == 22) { return TONE_LIT_EDGE; }
	if (ty == 8 || ty == 9 || ty == 23 || ty == 24) { return TONE_ACCENT; }
	if (ty >= 14 && ty <= 17 && (tx == 13 || tx == 18)) { return TONE_LIT_EDGE; }
	if (tx % 5 == 0) { return TONE_DARK_EDGE; }
	return grit(kind, tx, ty);
}

// the exit: a switch box over hazard stripes, two green lamps
def switch_tone(tx, ty) {
	if (tx < 2 || tx > 29 || ty < 2) { return TONE_DARK_EDGE; }
	if (ty >= 24) { return ((tx + ty) >> 2 & 1) == 0 ? TONE_ACCENT : TONE_GAP; }
	if (tx >= 9 && tx <= 22 && ty >= 5 && ty <= 20) {
		if (tx == 9 || ty == 5) { return TONE_LIT_EDGE; }
		if (tx == 22 || ty == 20) { return TONE_GAP; }
		if (tx >= 15 && tx <= 16 && ty >= 7 && ty <= 14) { return TONE_LIT_EDGE; }
		if ((tx == 12 || tx == 19) && ty >= 16 && ty <= 18) { return TONE_GLOW; }
		return TONE_GRIT_DARK;
	}
	return grit(6, tx, ty);
}

// --------------------------------------------------------------- sprites ----
// Sprites keep more light than walls at the same distance so a threat stays
// readable down a dark corridor; uppercase palette keys (eyes, gobs, flame)
// and every projectile glow at full brightness.
def showcase_sprite_lut(name, band, flash, variant) {
	var mood := MOODS[G.map_i];
	var art := ARTS[name];
	var glowing = name.substr(0, 3) == "pr_";
	var lum = 1.0 - band * 0.085;
	var glow = sprite_light(mood, variant);
	var light = cadd(cscale(mix_rgb(mood["light"], rgb(255, 255, 255), 0.55), lum), glow);
	var haze = cscale(mood["fog"], (1.0 - lum) * 0.8 * (1.0 - 15e-2 * light_level(variant)));
	var rgbs := art["rgb"];
	var keys := art["keys"];
	var lut = [0];
	var nc = vlen(rgbs);
	for (var c = 1; c < nc; ++c) {
		var r = rgbs[c][0];
		var g = rgbs[c][1];
		var b = rgbs[c][2];
		if (flash == 1) {
			r = imin(255, r + 170);
			g = imin(255, g + 150);
			b = imin(255, b + 140);
		}
		var color = rgb(r, g, b);
		var key = keys[c];
		if (glowing || (key >= "A" && key <= "Z")) {
			lut.push_back(color_idx(color));
		} else {
			lut.push_back(color_idx(cadd(cmul(color, light), haze)));
		}
	}
	return lut;
}

// per-kind particle ramps, phase 0 = fresh
global SHOWCASE_PARTICLE_RAMPS = [
	[rgb(0, 0, 0), rgb(0, 0, 0), rgb(0, 0, 0), rgb(0, 0, 0)],
	[rgb(255, 250, 214), rgb(255, 212, 110), rgb(240, 140, 50), rgb(150, 70, 30)],      // spark
	[rgb(232, 40, 30), rgb(190, 30, 24), rgb(140, 22, 18), rgb(90, 14, 12)],            // blood
	[rgb(214, 72, 54), rgb(172, 50, 38), rgb(128, 36, 28), rgb(86, 24, 20)],            // gib
	[rgb(104, 98, 94), rgb(84, 80, 78), rgb(64, 62, 62), rgb(46, 44, 46)],              // smoke
	[rgb(255, 255, 236), rgb(255, 240, 170), rgb(255, 200, 100), rgb(220, 130, 50)],    // flash
	[rgb(190, 255, 200), rgb(130, 245, 220), rgb(100, 200, 255), rgb(110, 120, 240)]    // hexmote
]

// ----------------------------------------------------------------- light ----
// The lit tables: one palette index per (light variant, side, shade, tone), so
// a surface under a lamp, a muzzle flash or a hex bolt costs one lookup more
// than an unlit one. Variant 0 is unlit; lights.chai names the rest.
global SURFACE_SHADES = 16
global FAR_TEXTURE = 3.2     // past this distance surfaces draw their far texture
global FLOOR_TONES = 12      // the eight wall tones, then blood, dried blood, scorch, ash
global TONE_BLOOD = 8
global TONE_BLOOD_DRY = 9
global TONE_SCORCH = 10
global TONE_ASH = 11
global WALL_TABLE_STRIDE = 6400    // LIGHT_VARIANTS x 2 sides x 16 shades x 8 tones

// the lit tables' colors, rounded to steps of LIT_STEP a channel
global LIT_STEP = 6

def lit_idx(c) {
	var half = LIT_STEP / 2;
	var r = (itrunc(c[0] * 255.0) + half) / LIT_STEP * LIT_STEP;
	var g = (itrunc(c[1] * 255.0) + half) / LIT_STEP * LIT_STEP;
	var b = (itrunc(c[2] * 255.0) + half) / LIT_STEP * LIT_STEP;
	return rgb_idx(r, g, b);
}

def light_color_of(mood, variant) {
	var channel = (variant - 1) / LIGHT_LEVELS;
	if (channel == LIGHT_LAMP) { return mix_rgb(mood["light"], LIGHT_COLORS[LIGHT_LAMP], 0.5); }
	return LIGHT_COLORS[channel];
}

// [variant][side][shade][tone] palette indices for one surface, appended to out
def push_lit_tones(out, mood, albedo, glow, sides) {
	var white = rgb(255, 255, 255);
	var black = rgb(0, 0, 0);
	var mlight := mood["light"];
	var mfog := mood["fog"];
	var ntones = vlen(albedo);
	for (var v = 0; v < LIGHT_VARIANTS; ++v) {
		var s = v == 0 ? 0.0 : 1.0 * light_level(v) / LIGHT_LEVELS;
		var lc = v == 0 ? black : light_color_of(mood, v);
		for (var side = 0; side < sides; ++side) {
			var light = cscale(side == 1 ? cscale(mix_rgb(mlight, mood["turned"], 0.3), 0.7) : mlight, AMBIENT);
			for (var shade = 0; shade < SURFACE_SHADES; ++shade) {
				var lum = shade_light(shade);
				var haze = cscale(mfog, 1.0 - lum);
				var lit = cadd(cscale(light, lum), cscale(lc, s * LIGHT_GAIN * (0.45 + 0.55 * lum)));
				var fog = cscale(haze, 1.0 - 0.6 * s);
				for (var tone = 0; tone < ntones; ++tone) {
					if (tone == TONE_GLOW) {
						out.push_back(lit_idx(cadd(cscale(mix_rgb(glow, white, 15e-2), 0.6 + 0.4 * lum), cscale(haze, 0.3))));
					} else {
						out.push_back(lit_idx(cadd(cmul(albedo[tone], lit), fog)));
					}
				}
			}
		}
	}
}

def wall_albedo(base, accent) {
	return [base, accent, cscale(base, 0.36), cclamp(cscale(base, 1.25)), cscale(base, 0.62), base, cscale(base, 86e-2),
		cclamp(cscale(base, 1.1))];
}

// the lit wall table of floor mi: [kind 0..8][variant][side][shade][tone]
def showcase_lit_wall_tones(mi) {
	var mood := MOODS[mi];
	var tones = [];
	var unseen = rgb(10, 10, 12);
	push_lit_tones(tones, mood, wall_albedo(unseen, unseen), unseen, 2);
	for (wall : mood["walls"]) {
		push_lit_tones(tones, mood, wall_albedo(wall, mix_rgb(wall, mood["light"], 0.18)), wall, 2);
	}
	for (fixture : FIXTURES) {
		push_lit_tones(tones, mood, wall_albedo(fixture[0], fixture[1]), fixture[2], 2);
	}
	return tones;
}

// what each floor is paved with, and what glows in its cracks
global FLOOR_GLOWS = [rgb(255, 210, 140), rgb(90, 236, 226), rgb(255, 122, 40), rgb(255, 60, 44)]

def showcase_floor_tones(mi) {
	var mood := MOODS[mi];
	var base = cclamp(cscale(mood["floor"], 1.3));
	var accent = mix_rgb(base, mood["walls"][0], 0.35);
	var albedo = wall_albedo(base, accent);
	albedo[TONE_GAP] = cscale(base, 0.55);
	albedo[TONE_GRIT_DARK] = cscale(base, 0.9);
	albedo[TONE_GRIT_LIGHT] = cclamp(cscale(base, 1.06));
	albedo.push_back(rgb(150, 16, 12));
	albedo.push_back(rgb(84, 10, 10));
	albedo.push_back(rgb(22, 18, 16));
	albedo.push_back(rgb(52, 46, 44));
	var tones = [];
	push_lit_tones(tones, mood, albedo, FLOOR_GLOWS[mi], 1);
	return tones;
}

def showcase_ceiling_tones(mi) {
	var mood := MOODS[mi];
	var base = cscale(mood["ceiling"], 85e-2);
	var albedo = wall_albedo(base, mix_rgb(base, mood["light"], 12e-2));
	albedo[TONE_GRIT_DARK] = cscale(base, 0.92);
	albedo[TONE_GRIT_LIGHT] = base;
	var tones = [];
	push_lit_tones(tones, mood, albedo, mix_rgb(mood["light"], rgb(255, 255, 255), 0.45), 1);
	return tones;
}

// ------------------------------------------------------ floor and ceiling ----
// 16x16 texels a tile; four variants a floor, picked per tile from a hash.
// Each texture comes twice: as drawn, then as seen from afar, where the
// one-texel lines and the grit would shimmer: only glow, tint and beams stay.
def far_tone(tone, keep_edges) {
	if (tone == TONE_GLOW || tone == TONE_ACCENT) { return tone; }
	if (keep_edges && (tone == TONE_GAP || tone == TONE_DARK_EDGE)) { return tone; }
	return TONE_BASE;
}

def showcase_floor_texture(mi) {
	var tex = [];
	for (var far = 0; far < 2; ++far) {
		for (var variant = 0; variant < 4; ++variant) {
			for (var v = 0; v < 16; ++v) {
				for (var u = 0; u < 16; ++u) {
					var tone = floor_tone(mi, variant, u, v);
					if (far == 1) { tone = mi == 1 ? far_tone(tone, false) : (tone == TONE_GLOW ? TONE_DARK_EDGE : far_tone(tone, false)); }
					tex.push_back(tone);
				}
			}
		}
	}
	return tex;
}

def floor_tone(mi, variant, u, v) {
	var n = texel_noise(20 + variant, u, v);
	if (mi == 1) {
		// coolant grating: plates over a lit channel
		if (u == 0 || v == 0) { return TONE_LIT_EDGE; }
		if (u == 15 || v == 15) { return TONE_GAP; }
		if (v >= 6 && v <= 9 && u >= 2 && u <= 13 && (u & 1) == 0) { return variant == 0 ? TONE_GLOW : TONE_GAP; }
		if ((u == 3 || u == 12) && (v == 3 || v == 12)) { return TONE_LIT_EDGE; }
		return n < 30 ? TONE_GRIT_DARK : TONE_BASE;
	}
	if (mi == 2) {
		// foundry basalt: blocks split by cracks that glow
		var x = (u + (v >> 3) * 5) & 15;
		var y = v & 7;
		var crack_at = variant == 0 ? (v * 3) / 4 + 3 + (v >> 2 & 1) : 99;
		if (u == crack_at || (variant == 0 && u == crack_at + 1 && (v & 3) == 0)) { return TONE_GLOW; }
		if (x == 15 || y == 7) { return TONE_GAP; }
		if (x == 0 || y == 0) { return TONE_LIT_EDGE; }
		if (n < 40) { return TONE_GRIT_DARK; }
		return variant == 3 ? TONE_ACCENT : TONE_BASE;
	}
	if (mi == 3) {
		// the throne: checkered tiles trimmed in gold
		if (u == 0 || v == 0 || u == 8 || v == 8) { return TONE_LIT_EDGE; }
		var dark = ((u >> 3) + (v >> 3)) % 2 == 0;
		if (dark) { return n < 50 ? TONE_GRIT_DARK : TONE_DARK_EDGE; }
		return n < 30 ? TONE_GRIT_LIGHT : TONE_ACCENT;
	}
	// flagstones, four to a tile, each its own tint
	var sx = u >> 3;
	var sy = v >> 3;
	var x2 = u & 7;
	var y2 = v & 7;
	if (x2 == 7 || y2 == 7) { return TONE_GAP; }
	if (x2 == 0 || y2 == 0) { return TONE_LIT_EDGE; }
	if (x2 == 6 || y2 == 6) { return TONE_DARK_EDGE; }
	if (((sx + sy * 2 + variant) % 3) == 0) { return n < 24 ? TONE_GRIT_DARK : TONE_ACCENT; }
	if (n < 26) { return TONE_GRIT_DARK; }
	if (n > 238) { return TONE_GRIT_LIGHT; }
	return TONE_BASE;
}

// ceiling panels between beams; variant 1 is a lamp
def showcase_ceiling_texture() {
	var tex = [];
	for (var far = 0; far < 2; ++far) {
		for (var lamp = 0; lamp < 2; ++lamp) {
			for (var v = 0; v < 16; ++v) {
				for (var u = 0; u < 16; ++u) {
					var tone = ceiling_tone(lamp == 1, u, v);
					tex.push_back(far == 1 ? far_tone(tone, true) : tone);
				}
			}
		}
	}
	return tex;
}

def ceiling_tone(lamp, u, v) {
	if (u < 2 || v < 2) { return u == 1 || v == 1 ? TONE_GAP : TONE_DARK_EDGE; }
	if (lamp && u >= 5 && u <= 12 && v >= 5 && v <= 12) {
		if (u == 5 || v == 5 || u == 12 || v == 12) { return TONE_LIT_EDGE; }
		return TONE_GLOW;
	}
	if (u == 2 || v == 2) { return TONE_LIT_EDGE; }
	return grit(9, u, v);
}

// every wall kind's texture as tones, 32x32 texels: [far][kind][ty][tx]
def showcase_wall_texture() {
	var tex = [];
	for (var far = 0; far < 2; ++far) {
		for (var kind = 0; kind < 9; ++kind) {
			for (var ty = 0; ty < 32; ++ty) {
				for (var tx = 0; tx < 32; ++tx) {
					var tone = showcase_tone(kind, tx, ty);
					tex.push_back(far == 1 ? far_tone(tone, true) : tone);
				}
			}
		}
	}
	return tex;
}

// a sprite's light: how a variant tints it
def sprite_light(mood, variant) {
	if (variant == 0) { return rgb(0, 0, 0); }
	return cscale(light_color_of(mood, variant), 0.9 * light_level(variant) / LIGHT_LEVELS);
}
